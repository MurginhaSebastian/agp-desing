# Configuración pública del frontend. Todo lo VITE_* termina en el bundle: NO poner secretos.
# Los valores de abajo son EJEMPLOS. Los reales van en `.env` (ignorado por git) y en el hosting.
# Vacío = modo demo con datos locales (sin backend). Con backend: http://localhost:8080
VITE_API_URL=
# WhatsApp del negocio: solo dígitos, con código de país y sin "+" (wa.me no lo acepta)
VITE_WHATSAPP_NUMBER=51999999999
VITE_INSTAGRAM_URL=https://www.instagram.com/ejemplo/
VITE_TIKTOK_URL=https://www.tiktok.com/@ejemplo
# Correo que aparece en las páginas de privacidad y términos
VITE_CONTACT_EMAIL=correo@ejemplo.com

# Tope de peso de una foto al subirla desde el panel, en MB. Tiene que coincidir con
# MAX_IMAGEN_MB del backend: el panel avisa antes de enviar y el servidor lo comprueba.
VITE_MAX_IMAGEN_MB=5
