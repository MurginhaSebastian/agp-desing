# Copiar a .env (o exportar como variables de entorno). NUNCA subir .env a git.
DB_URL=jdbc:postgresql://localhost:XXXX/agp
DB_USER=xxx
# En local, docker-compose usa este mismo valor (por defecto agp-dev-only). Si lo cambias después
# de crear el contenedor, borra el volumen: docker compose down -v
DB_PASSWORD=agpxxxx
# Mínimo 32 bytes aleatorios en Base64. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=8
# Origen exacto del frontend (sin barra final). Dev: http://localhost:XXXX
CORS_ALLOWED_ORIGIN=http://localhost:XXXX
# Proxies propios delante de la app. 0 en local. Detrás de Render/Railway hay que ponerlo y
# confirmar el número tras desplegar (ver docs/DEPLOY.md): con 0 detrás de un proxy, todos los
# visitantes parecen venir de la misma IP y un desconocido puede dejarte fuera del panel.
# Con 0 el freno del login cuenta por la IP de la conexión e ignora X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
# Usuario admin sembrado por Flyway (V2). Hash BCrypt, nunca la contraseña en claro.
# Generar el hash (htpasswd no viene en Windows; usar Docker). Los "$" del hash hacen que docker compose
# avise "variable is not set" al leer este .env: es solo un aviso, ignorarlo.
#   docker run --rm httpd:alpine htpasswd -bnBC 12 "" 'tu-clave' | tr -d ':\n'
ADMIN_USERNAME=XXXX
ADMIN_PASSWORD_HASH=

# --- Fotos subidas desde el panel (Supabase Storage) ---
# Sin estas tres variables la web funciona igual; lo unico que falla es subir una foto, y el
# panel lo dice con un mensaje claro.
SUPABASE_URL=https://XXXXXXXX.supabase.co
# Clave SECRETA de Supabase (service_role o sb_secret_...). Da acceso total a la base de datos:
# vive solo aqui y en las variables del hosting. NUNCA en el frontend ni en git.
SUPABASE_SERVICE_KEY=
# Bucket publico donde se guardan las fotos.
SUPABASE_BUCKET=productos
# Tope de peso de una foto. Tiene que coincidir con VITE_MAX_IMAGEN_MB del frontend.
MAX_IMAGEN_MB=5
