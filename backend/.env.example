# Copiar a .env (o exportar como variables de entorno). NUNCA subir .env a git.
DB_URL=jdbc:postgresql://localhost:5432/agp
DB_USER=agp
# En local, docker-compose usa este mismo valor (por defecto agp-dev-only). Si lo cambias después
# de crear el contenedor, borra el volumen: docker compose down -v
DB_PASSWORD=agp-dev-only
# Mínimo 32 bytes aleatorios en Base64. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=8
# Origen exacto del frontend (sin barra final). Dev: http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Usuario admin sembrado por Flyway (V2). Hash BCrypt, nunca la contraseña en claro.
# Generar el hash (htpasswd no viene en Windows; usar Docker). Los "$" del hash hacen que docker compose
# avise "variable is not set" al leer este .env: es solo un aviso, ignorarlo.
#   docker run --rm httpd:alpine htpasswd -bnBC 12 "" 'tu-clave' | tr -d ':\n'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
